# First job of the day: a 2-node smoke test on the team1 PGX boxes that answers the open
# questions in TODO.md (U1-U6, U10), with the SAME resources an
# experiment asks for (exclusive, 120GiB memory, 300GiB ephemeral volume).
#
#   fuzzball workflow start fuzzball/tests/smoke.fz --name coopmoe-smoke
#   fuzzball workflow log <id> smoke -f
#
# If it is rejected outright, lower one request at a time (memory, then the ephemeral size)
# to find which limit the cluster enforces. Writes only under /data/coopmoe/smoke (cleaned up).
version: v4

files:
  probe.sh: |
    #!/bin/bash
    # One box. $1 = rank. Every section is prefixed with the rank and host.
    R=$1; D=/data/coopmoe/smoke; mkdir -p "$D"
    h() { echo; echo "--- [rank$R $(hostname)] $*"; }
    h "U1 GPU / node"
    nvidia-smi --query-gpu=name,memory.total,driver_version --format=csv,noheader
    echo "arch $(uname -m), $(nproc) cores, hosts in job: $MULTINODE_HOSTLIST_NOSLOTS"
    h "U4 memory"
    free -g | head -2
    echo "cgroup memory.max = $(cat /sys/fs/cgroup/memory.max 2>/dev/null || echo '?')"
    h "U5 network interfaces (CX-7 shows up as ConnectX / mlx5, 200000 Mb/s)"
    ip -br addr | grep -v '^lo'
    for i in /sys/class/net/*; do n=${i##*/}; [ "$n" = lo ] && continue
      echo "$n speed=$(cat $i/speed 2>/dev/null || echo ?)Mb/s driver=$(basename "$(readlink $i/device/driver 2>/dev/null)" 2>/dev/null)"; done
    ls /sys/class/infiniband 2>/dev/null | sed 's/^/rdma device: /'
    for x in $(echo "$MULTINODE_HOSTLIST_NOSLOTS" | tr , ' '); do getent hosts "$x"; done
    h "U2 where the volumes really are"
    findmnt -T /data/coopmoe; findmnt -T /local
    df -h /data/coopmoe /local
    lsblk -o NAME,SIZE,TYPE,MODEL,MOUNTPOINT 2>/dev/null | head -20
    h "U2/U3 local disk (/local): 8 GiB direct write, then read"
    dd if=/dev/zero of=/local/t bs=4M count=2048 oflag=direct 2>&1 | tail -1
    dd if=/local/t of=/dev/null bs=4M iflag=direct 2>&1 | tail -1
    rm -f /local/t
    h "U3 NFS (/data/coopmoe), both boxes at the same time: 4 GiB direct write, then read"
    dd if=/dev/zero of="$D/t.$(hostname)" bs=4M count=1024 oflag=direct 2>&1 | tail -1
    dd if="$D/t.$(hostname)" of=/dev/null bs=4M iflag=direct 2>&1 | tail -1
    rm -f "$D/t.$(hostname)"
    h "U1/U4 torch on GB10, and whether GPU memory counts against the job's memory limit"
    python3 - <<'PY'
    import torch
    def cg():
        try:
            return int(open("/sys/fs/cgroup/memory.current").read()) / 2**30
        except Exception:
            return float("nan")
    ok = torch.cuda.is_available()
    print("torch", torch.__version__, "cuda", ok, torch.cuda.get_device_name(0) if ok else "",
          torch.cuda.get_device_capability(0) if ok else "")
    if ok:
        a = cg()
        x = torch.empty(8 * 2**30, dtype=torch.uint8, device="cuda"); x.fill_(1); torch.cuda.synchronize()
        b = cg()
        print(f"cgroup memory.current {a:.1f} -> {b:.1f} GiB after an 8 GiB GPU allocation: GPU memory "
              f"{'IS' if b - a > 6 else 'is NOT (or not visibly)'} charged to the job's limit")
        free, total = torch.cuda.mem_get_info()
        print(f"cuda mem_get_info: {free / 2**30:.1f} GiB free of {total / 2**30:.1f} GiB")
    PY
    h "U10 the engine's Python: transformers 5.23.0 installs in the image, HF batching runs on the GPU"
    python3 --version
    python3 -m venv --system-site-packages /tmp/v && /tmp/v/bin/pip install -q transformers==5.23.0 2>&1 | tail -5
    /tmp/v/bin/python - <<'PY'
    import sys, torch, transformers
    from transformers import ContinuousBatchingConfig, GenerationConfig, Qwen3MoeConfig, Qwen3MoeForCausalLM
    dev = "cuda"
    print("transformers", transformers.__version__, "torch", torch.__version__, "python", sys.version.split()[0])
    cfg = Qwen3MoeConfig(vocab_size=1000, hidden_size=128, intermediate_size=256, moe_intermediate_size=128,
                         num_hidden_layers=2, num_attention_heads=4, num_key_value_heads=2, head_dim=32,
                         num_experts=8, num_experts_per_tok=2)
    cfg._attn_implementation = "sdpa"
    m = Qwen3MoeForCausalLM(cfg).to(dev, torch.bfloat16).eval()
    gen = GenerationConfig(do_sample=False, max_new_tokens=8, eos_token_id=-1)
    cbc = ContinuousBatchingConfig(page_size=256, num_blocks=4, max_batch_tokens=512, max_requests_per_batch=2,
                                   use_cuda_graph=False, use_async_batching=False, allow_block_sharing=False,
                                   auto_switch_to_flash=False)
    cb = m.init_continuous_batching(generation_config=gen, continuous_batching_config=cbc)
    cb.start()
    for i in range(2):
        cb.add_request([1, 2, 3, 4 + i], request_id=f"r{i}", max_new_tokens=8, eos_token_id=-1)
    outs = [cb.get_result(timeout=120) for _ in range(2)]
    cb.stop()
    print("HF continuous batching on", torch.cuda.get_device_name(0) if dev == "cuda" else dev, ":",
          [(o.request_id, len(o.generated_tokens), o.error) if o else None for o in outs])
    PY

    h "U5 link to the other box"
    python3 /opt/smoke/link.py "$R" "$D"
  link.py: |
    """Rank 1 serves; rank 0 measures round trip and one-stream TCP bulk rate to every address
    rank 1 has (they meet through a file on the shared NFS volume). Plain Python TCP, the same
    kind of path CoopMoE's PeerLink uses today: a lower bound on what the link can do."""
    import os, socket, sys, time
    rank, d = int(sys.argv[1]), sys.argv[2]
    tag = os.environ.get("FB_WORKFLOW_ID", "")
    f = os.path.join(d, "peer_ips" + ("." + tag if tag else ""))
    PORT, N_PING, BULK = 29700, 1000, 2 * 2**30

    def recvn(c, n):
        b = bytearray()
        while len(b) < n:
            k = c.recv(n - len(b))
            if not k:
                raise ConnectionError("closed")
            b += k
        return bytes(b)

    if rank:
        ips = [ip for ip in os.popen("hostname -I").read().split() if ":" not in ip]
        srv = socket.socket(); srv.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
        srv.bind(("0.0.0.0", PORT)); srv.listen(8); srv.settimeout(600)
        open(f + ".tmp", "w").write(" ".join(ips)); os.replace(f + ".tmp", f)
        print(f"serving on {ips} port {PORT}", flush=True)
        while True:
            try:
                c, _ = srv.accept()
            except socket.timeout:
                break
            c.setsockopt(socket.IPPROTO_TCP, socket.TCP_NODELAY, 1)
            kind = recvn(c, 1)
            if kind == b"q":
                break
            if kind == b"p":
                for _ in range(N_PING):
                    c.sendall(recvn(c, 64))
            elif kind == b"b":
                n, got = int.from_bytes(recvn(c, 8), "big"), 0
                while got < n:
                    got += len(c.recv(1 << 22))
                c.sendall(b"k")
            c.close()
        os.remove(f)
    else:
        t0 = time.time()
        while not (os.path.exists(f) and os.path.getmtime(f) > t0 - 120):
            if time.time() - t0 > 300:
                sys.exit(print("rank 1 never published its addresses"))
            time.sleep(1)
        payload = memoryview(bytes(1 << 22))
        for ip in open(f).read().split():
            try:
                c = socket.create_connection((ip, PORT), timeout=3); c.settimeout(60)
                c.setsockopt(socket.IPPROTO_TCP, socket.TCP_NODELAY, 1); c.sendall(b"p")
                msg, t = bytes(64), time.perf_counter()
                for _ in range(N_PING):
                    c.sendall(msg); recvn(c, 64)
                rtt = (time.perf_counter() - t) / N_PING * 1e6; c.close()
                c = socket.create_connection((ip, PORT), timeout=3); c.settimeout(120)
                c.sendall(b"b" + BULK.to_bytes(8, "big")); t = time.perf_counter()
                for _ in range(BULK // len(payload)):
                    c.sendall(payload)
                recvn(c, 1); rate = BULK / (time.perf_counter() - t) / 1e9; c.close()
                print(f"peer {ip}: round trip {rtt:.0f} us (64 B), bulk {rate:.2f} GB/s (one Python TCP stream)")
            except Exception as e:
                print(f"peer {ip}: unreachable ({e})")
        for ip in open(f).read().split():  # release rank 1
            try:
                socket.create_connection((ip, PORT), timeout=3).sendall(b"q")
                break
            except Exception:
                pass

volumes:
  data:
    use: team1
    name: coopMoE
  local:
    use: ephemeral
    size: 300GiB

jobs:
  smoke:
    image:
      uri: docker://nvcr.io/nvidia/pytorch:25.09-py3
    script: |
      #!/bin/bash
      . /multinode/generic-helper
      exec_rank0 "bash /opt/smoke/probe.sh 0"
      exec_rankN "bash /opt/smoke/probe.sh 1"
      wait_rank0
    env:
      - MULTINODE_WRAPPER_FORWARD_STREAMS=1
    files:
      /opt/smoke/probe.sh: file://probe.sh
      /opt/smoke/link.py: file://link.py
    mounts:
      /data/coopmoe: data
      /local: local
    resource:
      cpu:
        cores: 20
      memory:
        size: 120GiB
      devices:
        nvidia.com/gpu: 1
      exclusive: true
    multinode:
      nodes: 2
      implementation: generic
    policy:
      timeout:
        execute: 30m
