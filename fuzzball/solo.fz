# The baseline: ONE box of the pair, as a single-node Fuzzball workflow (v4 syntax).
# driver.py --baseline renders this once per box, starts both, and merges their results. The
# two jobs never talk to each other, so no expert crosses the link: a miss is read from this
# box's own NVMe. Everything else is what fuzzball/coopmoe.fz runs: the same image,
# resources, store copy, run config, cache size and this box's share of the same requests.
#
#   data     the model's NFS volume: the expert store (built once by fuzzball/stage.fz)
#   scratch  this node's own NVMe, wiped when the job ends: the store is copied here at job
#            start and the misses are read from it
version: v4

files:
  bootstrap.sh: |
{{BOOTSTRAP}}
  code.tgz.b64: |
{{CODE}}
  requests.json: |
{{REQUESTS}}

volumes:
  data:
    use: {{VOLUME_USE}}
    name: {{VOLUME}}
  scratch:
    use: {{SCRATCH}}

jobs:
  run:
    image:
      uri: {{IMAGE}}
    script: |
      #!/bin/bash
      bash /opt/coopmoe/bootstrap.sh run
    env:
      - HF_HOME={{DATA}}/hf-cache
    files:
      /opt/coopmoe/bootstrap.sh: file://bootstrap.sh
      /opt/coopmoe/code.tgz.b64: file://code.tgz.b64
      /opt/coopmoe/requests.json: file://requests.json
    mounts:
      {{DATA}}: data
      {{LOCAL}}: scratch
    resource:
      cpu:
        cores: {{CORES}}
      # Unified memory: a hard limit, the same as each node of the linked job.
      memory:
        size: {{MEMORY}}
      devices:
        nvidia.com/gpu: {{GPUS}}
      exclusive: true
    policy:
      timeout:
        execute: {{TIMEOUT}}
