# One CoopMoE experiment on the team's two PGX boxes (DGX Spark, GB10), as a Fuzzball workflow
# (v4 syntax). driver.py fills in every double-brace placeholder, saves the result next to the
# run's results as coopmoe.fz, validates it and starts it.
#
# One multinode job, two nodes, implementation "generic":
#   rank 0 (PGX-A): copies the store to its local disk, starts box 0's engine, runs the
#                   requests through the scheduler, prints the results into this job's log
#   rank 1 (PGX-B): copies the store to its local disk, serves as box 1 until rank 0 stops it
# The code and the requests travel inside the workflow (files:), so the job needs no git access.
#
# Storage, as found on fb-hack (README, "The cluster"):
#   data   the team's persistent volume: NFS (10.10.11.1:/hackathon/team-01), the SAME files
#          on both boxes. Holds the one expert store (built once by fuzzball/stage.fz), the
#          calibration files and the results.
#   scratch  each node's own NVMe (a hostpath volume: /dev/nvme0n1p2 on the node), wiped when
#          the job ends. Each box copies the store here at job start and reads its expert
#          misses from it, as the design assumes.
version: v4

files:
  bootstrap.sh: |
{{BOOTSTRAP}}
  code.tgz.b64: |
{{CODE}}
  requests.json: |
{{REQUESTS}}

volumes:
  data:
    use: {{VOLUME_USE}}
    name: {{VOLUME}}
  scratch:
    use: {{SCRATCH}}

jobs:
  run:
    image:
      uri: {{IMAGE}}
    script: |
      #!/bin/bash
      . /multinode/generic-helper
      exec_rank0 "bash /opt/coopmoe/bootstrap.sh run"
      exec_rankN "bash /opt/coopmoe/bootstrap.sh engine"
      wait_rank0
    env:
      - MULTINODE_WRAPPER_FORWARD_STREAMS=1
      - HF_HOME={{DATA}}/hf-cache
    files:
      /opt/coopmoe/bootstrap.sh: file://bootstrap.sh
      /opt/coopmoe/code.tgz.b64: file://code.tgz.b64
      /opt/coopmoe/requests.json: file://requests.json
    mounts:
      {{DATA}}: data
      {{LOCAL}}: scratch
    resource:
      cpu:
        cores: {{CORES}}
      # GB10 memory is unified: the expert cache, weights and KV come out of this same pool.
      # This is a hard limit (the process is killed above it), so it asks for nearly the whole
      # node; cache.gb in the run config sizes the cache (U4).
      memory:
        size: {{MEMORY}}
      devices:
        nvidia.com/gpu: {{GPUS}}
      exclusive: true
    multinode:
      nodes: 2
      implementation: generic
    policy:
      timeout:
        execute: {{TIMEOUT}}
